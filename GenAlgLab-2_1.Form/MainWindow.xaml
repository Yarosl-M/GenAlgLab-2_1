<Window x:Class="GenAlgLab_2_1.Form.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Генетический алгоритм решения задачи коммивояжёра"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="600">

    <Grid Margin="12">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>


        <!-- ===================================================== -->
        <!-- Визуализация -->
        <!-- ===================================================== -->

        <TabControl x:Name="VisualizationTabs"
                    Grid.Column="0">

            <!-- Маршрут/Схема графа -->

            <TabItem x:Name="RouteTab"
                     Header="Маршрут">

                <Grid Margin="5">

                    <Canvas x:Name="RouteCanvas"
                            Background="White"/>

                </Grid>

            </TabItem>


            <!-- Статистика/Графики для fitness-функции -->

            <TabItem x:Name="StatisticsTab"
                     Header="Статистика">

                <Grid Margin="10">

                    <Canvas x:Name="StatisticsCanvas"
                            Background="White"/>

                </Grid>

            </TabItem>

        </TabControl>


        <!-- ===================================================== -->
        <!-- Параметры алгоритма -->
        <!-- ===================================================== -->

        <ScrollViewer x:Name="ParametersScrollViewer"
                      Grid.Column="2"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <TextBlock x:Name="ParametersTitle"
                           Text="Параметры генетического алгоритма"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,16"/>
                

                <GroupBox x:Name="TaskGroupBox"
                          Header="Задача"
                          Margin="0,0,0,12">

                    <Grid Margin="10">

                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Text="Количество городов:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="CityCountTextBox"
                                 Grid.Column="1"
                                 Text="100"
                                 Margin="5,2"/>


                        <TextBlock Grid.Row="1"
                                   Text="Тип теста:"
                                   VerticalAlignment="Center"/>

                        <ComboBox x:Name="TestTypeComboBox"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="5,2"
                                  SelectedIndex="0">

                            <ComboBoxItem Content="Нейросеть"/>
                            <ComboBoxItem Content="Города на линии"/>

                        </ComboBox>


                        <TextBlock Grid.Row="2"
                                   Text="Шаг линии:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="LineStepTextBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Text="1"
                                 Margin="5,2"/>

                    </Grid>

                </GroupBox>


                <!-- Популяция -->

                <GroupBox x:Name="PopulationGroupBox"
                          Header="Популяция"
                          Margin="0,0,0,12">

                    <Grid Margin="10">

                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Text="Размер популяции:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="PopulationSizeTextBox"
                                 Grid.Column="1"
                                 Text="100"
                                 Margin="5,2"/>


                        <TextBlock Grid.Row="1"
                                   Text="Поколений:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="GenerationCountTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Text="1000"
                                 Margin="5,2"/>


                        <TextBlock Grid.Row="2"
                                   Text="Seed:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="SeedTextBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Text="42"
                                 Margin="5,2"/>

                    </Grid>

                </GroupBox>


                <!-- Селекция -->

                <GroupBox x:Name="SelectionGroupBox"
                          Header="Селекция"
                          Margin="0,0,0,12">

                    <Grid Margin="10">

                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Text="Метод:"
                                   VerticalAlignment="Center"/>

                        <ComboBox x:Name="SelectionMethodComboBox"
                                  Grid.Column="1"
                                  Margin="5,2"
                                  SelectedIndex="0">

                            <ComboBoxItem Content="Простое отсечение"/>
                            <ComboBoxItem Content="Рулетка"/>
                            <ComboBoxItem Content="Турнир"/>
                            <ComboBoxItem Content="Ранжированное"/>

                        </ComboBox>


                        <TextBlock Grid.Row="1"
                                   Text="Размер турнира:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="TournamentSizeTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Text="3"
                                 Margin="5,2"/>


                        <!--<TextBlock Grid.Row="2"
                                   Text="Количество родителей:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="ParentCountTextBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Text="50"
                                 Margin="5,2"/>-->

                    </Grid>

                </GroupBox>


                <!-- Кроссинговер (пущай будет одинаковый пока что) -->

                <!--<GroupBox x:Name="CrossoverGroupBox"
                          Header="Кроссовер"
                          Margin="0,0,0,12">

                    <Grid Margin="10">

                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Text="Метод:"
                                   VerticalAlignment="Center"/>

                        <ComboBox x:Name="CrossoverMethodComboBox"
                                  Grid.Column="1"
                                  Margin="5,2"
                                  SelectedIndex="0">

                            <ComboBoxItem Content="Order Crossover (OX)"/>
                            <ComboBoxItem Content="PMX"/>

                        </ComboBox>


                        <TextBlock Grid.Row="1"
                                   Text="Вероятность:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="CrossoverProbabilityTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Text="0.9"
                                 Margin="5,2"/>

                    </Grid>

                </GroupBox>-->


                <!-- Мутации -->

                <GroupBox x:Name="MutationGroupBox"
                          Header="Мутация"
                          Margin="0,0,0,12">

                    <Grid Margin="10">

                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Text="Метод:"
                                   VerticalAlignment="Center"/>

                        <ComboBox x:Name="MutationMethodComboBox"
                                  Grid.Column="1"
                                  Margin="5,2"
                                  SelectedIndex="0">

                            <ComboBoxItem Content="Обращением"/>
                            <ComboBoxItem Content="Перестановкой"/>
                            <!--<ComboBoxItem Content="Inversion"/>-->

                        </ComboBox>


                        <TextBlock Grid.Row="1"
                                   Text="Вероятность, %:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="MutationProbabilityTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Text="5"
                                 Margin="5,2"/>


                        <TextBlock Grid.Row="2"
                                   Text="Количество мутаций:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="MutationCountTextBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Text="1"
                                 Margin="5,2"/>

                    </Grid>

                </GroupBox>


                <!-- Элитизм -->

                <GroupBox x:Name="ElitismGroupBox"
                          Header="Элитизм"
                          Margin="0,0,0,12">

                    <Grid Margin="10">

                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <CheckBox x:Name="ElitismCheckBox"
                                  Content="Использовать элитизм"
                                  IsChecked="True"
                                  VerticalAlignment="Center"/>


                        <TextBlock Grid.Row="1"
                                   Text="Количество элитных особей:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="EliteCountTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Text="2"
                                 Margin="5,2"/>

                    </Grid>

                </GroupBox>


                <!-- Условие останова -->

                <GroupBox x:Name="StoppingConditionGroupBox"
                          Header="Условие остановки"
                          Margin="0,0,0,12">

                    <Grid Margin="10">

                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Text="Тип:"
                                   VerticalAlignment="Center"/>

                        <ComboBox x:Name="StoppingConditionComboBox"
                                  Grid.Column="1"
                                  Margin="5,2"
                                  SelectedIndex="0">

                            <ComboBoxItem Content="Максимум поколений"/>
                            <ComboBoxItem Content="Без улучшения"/>

                        </ComboBox>


                        <TextBlock Grid.Row="1"
                                   Text="Порог:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="StoppingThresholdTextBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Text="1000"
                                 Margin="5,2"/>

                    </Grid>

                </GroupBox>


                <!-- Кнопки для операций -->

                <Button x:Name="StartButton"
                        Content="Запустить"
                        Height="40"
                        FontSize="16"
                        Margin="0,5,0,0"/>

                <Button x:Name="StopButton"
                        Content="Остановить"
                        Height="35"
                        Margin="0,5,0,0"/>

                <Button x:Name="ResetButton"
                        Content="Сбросить"
                        Height="35"
                        Margin="0,5,0,0"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>